{
    "name": "empire",
    "description": "Empire: Wargame of the Century",
    "authors": ["Walter Bright"],
    "license": "proprietary",
    "targetType": "executable",
    "targetName": "empire",
    "sourcePaths": [
        "source",
        "source/core",
        "source/platform/windows"
    ],
    "importPaths": [
        "source",
        "source/core",
        "source/platform/windows"
    ],
    "dflags-ldc": ["-mcpu=native"],
    "dflags-dmd": [],
    "lflags-windows": [
        "/SUBSYSTEM:WINDOWS",
        "user32.lib",
        "gdi32.lib",
        "winmm.lib",
        "comdlg32.lib",
        "shcore.lib",
        "empire.res"
    ],
    "buildTypes": {
        "release": {
            "buildOptions": ["releaseMode", "optimize", "inline"]
        },
        "debug": {
            "buildOptions": ["debugMode", "debugInfo"]
        }
    },
    "configurations": [
        {
            "name": "windows",
            "platforms": ["windows"]
        }
    ]
}
